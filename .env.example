# Paths to standalone leaf clones (documented links — not committed as code)
CTI_ROOT=C:\Users\MOHD\Desktop\Projects\CTI
HUNT_ROOT=C:\Users\MOHD\hunt-platform

# Hunt human token — must match NEBULA_HUMAN_TOKEN on hunt-platform.
# Never commit a real value. Console Vite reads VITE_HUNT_TOKEN from process env.
NEBULA_HUMAN_TOKEN=
VITE_HUNT_TOKEN=
VITE_HUNT_API_URL=http://127.0.0.1:8788
VITE_HUNT_PLATFORM_URL=http://127.0.0.1:8788

# Optional: cti-core enrich proxy target (hunt-platform intel-core)
INTEL_CORE_URL=http://127.0.0.1:8787

# Optional CTI API token (required off-loopback)
CTI_API_TOKEN=
VITE_CTI_API_TOKEN=

# Start behavior
# HUNT_NO_SECRETS=1 skips loading hunt secrets file (default in start scripts)
HUNT_NO_SECRETS=1
# NEBULA_REUSE_ONLY=1 only reports/reuses live ports — never starts leaf processes
# NEBULA_REUSE_ONLY=0
